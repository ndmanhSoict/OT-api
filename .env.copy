# ==========================================
# THÔNG TIN KẾT NỐI CƠ SỞ DỮ LIỆU MYSQL
# ==========================================

# Cấu hình biến môi trường rời (Dùng cho TypeORM, Sequelize, mysql2...)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=password123
DB_NAME=SHTT_db

# Chuỗi kết nối URI tổng hợp (Dành riêng cho Prisma hoặc các ORM hỗ trợ URL)
# Cú pháp: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password123@127.0.0.1:3308/SHTT_db"

# JWT Secrets
JWT_ACCESS_SECRET=chuoi_bi_mat_cho_access_token_rat_dai_va_kho_doan
JWT_REFRESH_SECRET=chuoi_bi_mat_cho_refresh_token_cung_rat_dai_va_kho_doan
# Access token sống 15 phút
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token sống 7 ngày
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CẤU HÌNH MẬT KHẨU
# ==========================================
DEFAULT_PASSWORD=Test@123
BCRYPT_ROUNDS=10

# ==========================================
# CẤU HÌNH SERVER
# ==========================================
PORT=3000
NODE_ENV=development
